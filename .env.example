# Copy to .env and fill locally. Never commit .env.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=wzblog
DB_USER=wzblog
DB_PASSWORD=<set-locally>

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DATABASE=1
# REDIS_PASSWORD=

JWT_SECRET=<at-least-32-bytes-random>

# local | minio (local is the default for development)
FILE_STORAGE=local
FILE_STORAGE_ROOT=./data/uploads
FILE_PUBLIC_BASE_URL=http://localhost:8021/media

# Admin bootstrap (optional; created on first startup)
WZBLOG_ADMIN_USERNAME=admin
WZBLOG_ADMIN_PASSWORD=<set-locally>
WZBLOG_ADMIN_EMAIL=admin@wzblog.local

# Verification code hashing/logging
WZBLOG_CODE_PEPPER=<random-32-bytes>
WZBLOG_LOG_VERIFICATION_CODE=true

# Optional external integrations
# ZHIPU_API_KEY=
# WECHAT_MINIAPP_APPID=
# WECHAT_MINIAPP_SECRET=